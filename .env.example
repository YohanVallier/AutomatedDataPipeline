# =============================================================================
# My Project - Example Environment Variables
# =============================================================================
# Copy this file to `.env` and adjust the values for your local environment.
# NEVER commit the real `.env` file to version control.
#
#   cp .env.example .env
#
# All variables below are optional; sensible defaults are applied when unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Input / Output directories
# -----------------------------------------------------------------------------
# Directory scanned for incoming .xlsx and .csv files (relative to project root).
INPUT_DIR=input_data

# Directory where the consolidated Excel report is written.
OUTPUT_DIR=output_data

# Name of the generated consolidated Excel workbook.
OUTPUT_FILENAME=consolidated_report.xlsx

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Directory where execution.log is written.
LOG_DIR=logs

# Log file name.
LOG_FILENAME=execution.log

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Data processing rules
# -----------------------------------------------------------------------------
# Fill value used for numeric nulls (e.g. quantity, price).
NULL_NUMERIC_FILL_VALUE=0

# Fill value used for textual nulls (e.g. product name, branch).
NULL_TEXT_FILL_VALUE=UNKNOWN

# Drop rows where critical columns (e.g. date, branch) are null.
DROP_CRITICAL_NULLS=true

# Threshold below which stock is considered critical.
CRITICAL_STOCK_THRESHOLD=10

# -----------------------------------------------------------------------------
# Excel export options
# -----------------------------------------------------------------------------
# Sheet name for the consolidated raw data.
SHEET_CONSOLIDATED=Consolidated

# Sheet name for the sales-by-branch summary.
SHEET_SALES_BY_BRANCH=SalesByBranch

# Sheet name for the critical-stock summary.
SHEET_CRITICAL_STOCK=CriticalStock

# -----------------------------------------------------------------------------
# Runtime behaviour
# -----------------------------------------------------------------------------
# Continue processing remaining files when one fails (true/false).
CONTINUE_ON_ERROR=true

# Environment name: development, staging, production
ENVIRONMENT=development